# Create a free account at https://resend.com
# For local tests with onboarding@resend.dev, sign up with the same address as CONTACT_TO_EMAIL.
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=contact@altwy.com
CONTACT_FROM_EMAIL="Altwy <onboarding@resend.dev>"
# Optional: extra allowed origins besides the current Host header
# CONTACT_ALLOWED_ORIGINS=https://altwy.com,https://www.altwy.com

# Cloudflare Turnstile — create keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local dummy keys (always pass, never use in production):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Public site URL (Open Graph / absolute image URLs)
NEXT_PUBLIC_SITE_URL=https://altwy.com

# Admin news dashboard (/admin)
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-admin-password.mjs "your-password"
# Use the base64 value (not the raw $2b$... hash) — dotenv expands $ otherwise
ADMIN_PASSWORD_HASH=
# Min 32 characters (e.g. openssl rand -hex 32)
ADMIN_SESSION_SECRET=
